---
export const prerender = false;

import ArrowSVG from "@assets/icons/arrow_down.svg";
import CheckmarkSVG from "@assets/icons/checkmark.svg";

import DefaultPage from "@layouts/DefaultPage.astro";

import FormattedDate from "@elements/FormattedDate.astro";
import RssSubscribe from "@elements/RssSubscribe.astro";

import readingTime from "reading-time";

import { getCollection } from "astro:content";

import { useTranslations } from "@i18n/index";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const tags = Astro.url.searchParams.get("tags")?.split(",").filter(Boolean) ?? [];

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();

const filteredPosts =
  tags.length > 0
    ? posts.filter((post) => Array.isArray(post.data.tags) && post.data.tags.some((tag) => tags.includes(tag)))
    : posts;

const postCountText =
  filteredPosts.length > 0
    ? filteredPosts.length > 1
      ? t("blog.showingPosts", { count: filteredPosts.length.toString() })
      : t("blog.showingPost", { count: filteredPosts.length.toString() })
    : t("blog.noPosts");
---

<DefaultPage title={t("blog.title")} description={t("blog.description")}>
  <main class="flex flex-col items-center justify-center gap-16 px-2">
    <h1 class="text-6xl font-bold">{t("blog.title")}</h1>
    <RssSubscribe />

    <div class="flex flex-col items-center gap-4">
      <div>
        <button
          id="dropdown-button"
          class="focus:border-accent focus:ring-accent flex min-w-50 items-center justify-between rounded-md border border-gray-300/50 bg-gray-700/50 px-3 py-2 text-sm focus:ring-1 focus:outline-none"
        >
          {t("blog.selectTags")}
          <ArrowSVG id="dropdown-arrow" class="size-3 text-gray-300 transition-transform duration-200" />
        </button>

        <div
          id="dropdown-menu"
          class="bg-backgroundlight absolute z-50 min-w-50 rounded-md border border-gray-700/30 shadow-lg transition-all duration-200"
        >
          {allTags.map((tag) => (
            <button
              class="tag-button flex w-full items-center justify-between px-3 py-2 hover:bg-gray-700/10"
              data-tag={tag}
            >
              {tag}
              {tags.includes(tag) && <CheckmarkSVG class="text-accent h-4 w-4" />}
            </button>
          ))}
        </div>
      </div>

      <div id="selected-tags" class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="bg-accent flex items-center gap-1 rounded-full px-3 py-1 text-white">
            {tag}
            <button class="remove-tag-button h-4 w-4 cursor-pointer hover:text-gray-200" data-tag={tag}>
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </span>
        ))}
      </div>
    </div>

    <p class="fade-in-section text-center">{postCountText}</p>

    <section class="flex max-w-4xl flex-col items-center justify-around gap-12">
      {filteredPosts.map((post) => (
        <article class="fade-in-section flex w-full flex-col">
          <p class="text-accent text-sm">
            {t("common.minRead", { time: Math.round(readingTime(post.body ?? "").minutes) })}
          </p>
          <a href={`/blog/${post.id}/`}>
            <h2 class="text-2xl font-bold">{post.data.title}</h2>
          </a>
          <p class="pt-2 text-sm">
            <FormattedDate date={post.data.pubDate} />
          </p>
        </article>
      ))}
    </section>
  </main>
</DefaultPage>

<style>
  #dropdown-menu {
    opacity: 0;
    visibility: hidden;
  }

  #dropdown-menu.open {
    opacity: 1;
    visibility: visible;
  }

  #dropdown-arrow.open {
    transform: rotate(180deg);
  }
</style>

<script>
  const dropdownButton = document.getElementById("dropdown-button");
  const dropdownMenu = document.getElementById("dropdown-menu");
  const dropdownArrow = document.getElementById("dropdown-arrow");

  const selectedTags = new Set(
    new URLSearchParams(window.location.search).get("tags")?.split(",").filter(Boolean) ?? [],
  );

  function navigateWithSelectedTags() {
    const url = new URL(window.location.href);
    if (selectedTags.size > 0) {
      url.searchParams.set("tags", Array.from(selectedTags).join(","));
    } else {
      url.searchParams.delete("tags");
    }
    window.location.href = url.toString();
  }

  dropdownButton?.addEventListener("click", () => {
    dropdownMenu?.classList.toggle("open");
    dropdownArrow?.classList.toggle("open");
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!dropdownMenu?.contains(target) && !dropdownButton?.contains(target)) {
      dropdownMenu?.classList.remove("open");
      dropdownArrow?.classList.remove("open");
    }
  });

  document.querySelectorAll<HTMLButtonElement>(".tag-button").forEach((button) => {
    button.addEventListener("click", () => {
      const tag = button.dataset.tag;
      if (!tag) return;
      if (selectedTags.has(tag)) {
        selectedTags.delete(tag);
      } else {
        selectedTags.add(tag);
      }
      navigateWithSelectedTags();
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".remove-tag-button").forEach((button) => {
    button.addEventListener("click", () => {
      const tag = button.dataset.tag;
      if (!tag) return;
      selectedTags.delete(tag);
      navigateWithSelectedTags();
    });
  });
</script>
