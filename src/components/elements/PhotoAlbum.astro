---
import { IMMICH_API_KEY, IMMICH_URL } from "astro:env/server";

import cache from "@api/_cache";

interface Props {
  albumId: string;
}

interface AlbumCard {
  name: string;
  shareUrl: string;
  thumbnailUrl: string;
}

const { albumId } = Astro.props;

async function getAlbumCard(albumId: string): Promise<AlbumCard | null> {
  const cacheKey = `immichAlbum:${albumId}`;
  const cached = cache.get<AlbumCard>(cacheKey);
  if (cached) return cached;

  const headers = { Accept: "application/json", "x-api-key": IMMICH_API_KEY ?? "" };

  try {
    const [albumRes, sharedLinksRes] = await Promise.all([
      fetch(`${IMMICH_URL}api/albums/${albumId}`, { headers }),
      fetch(`${IMMICH_URL}api/shared-links?` + new URLSearchParams({ albumId }), { headers }),
    ]);

    if (!albumRes.ok || !sharedLinksRes.ok) {
      console.warn(`Failed to fetch Immich album ${albumId}: ${albumRes.status}, ${sharedLinksRes.status}`);
      return null;
    }

    const album: { albumName: string; albumThumbnailAssetId: string | null } = await albumRes.json();
    const sharedLinks: { key: string; album?: { id: string } }[] = await sharedLinksRes.json();
    const sharedLink = sharedLinks.find((link) => link.album?.id === albumId);

    if (!sharedLink || !album.albumThumbnailAssetId) {
      console.warn(`Immich album ${albumId} has no shared link or thumbnail`);
      return null;
    }

    const card: AlbumCard = {
      name: album.albumName,
      shareUrl: `${IMMICH_URL}share/${sharedLink.key}`,
      thumbnailUrl:
        `${IMMICH_URL}api/assets/${album.albumThumbnailAssetId}/thumbnail?` +
        new URLSearchParams({ size: "preview", key: sharedLink.key }),
    };
    cache.set(cacheKey, card, 60 * 60 * 1000);
    return card;
  } catch (error) {
    console.warn(`Error fetching Immich album ${albumId}:`, error);
    return null;
  }
}

const album = await getAlbumCard(albumId);
---

{album && (
  <a
    href={album.shareUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center gap-4 rounded-lg transition-all duration-300 hover:scale-105"
  >
    <article class="flex flex-col items-center justify-center gap-2">
      <img
        class="aspect-square rounded-lg object-cover"
        width={256}
        height={256}
        src={album.thumbnailUrl}
        alt={album.name}
      />
      <div class="flex justify-center gap-2">
        <h2 class="text-center text-2xl font-bold">{album.name}</h2>
      </div>
    </article>
  </a>
)}
