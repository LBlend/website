---
interface Props {
  stat: number;
  text: string;
  decimalPlaces: number;
  suffix?: string;
  locale?: string;
}

const { stat, text, decimalPlaces, suffix, locale = "en" } = Astro.props;

const separators = {
  en: { decimal: ".", separator: "," },
  ko: { decimal: ".", separator: "," },
  no: { decimal: ",", separator: " " },
};

const { decimal, separator } = separators[locale as keyof typeof separators] || separators["en"];
---

<article class="flex flex-col items-center justify-center gap-1">
  {stat > 0 ? (
    <span
      data-count-up={stat}
      data-suffix={suffix}
      data-decimal-places={decimalPlaces}
      data-separator={separator}
      data-decimal={decimal}
      class="text-center text-2xl font-bold"
    >
      {stat}
    </span>
  ) : (
    <span class="text-center text-2xl font-bold">?</span>
  )}
  <p class="text-center text-lg font-light">{text}</p>
</article>

<script>
  import { CountUp } from "countup.js";

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      observer.unobserve(entry.target);
      const element = entry.target as HTMLElement;
      new CountUp(element, Number(element.dataset.countUp), {
        duration: 3,
        decimalPlaces: Number(element.dataset.decimalPlaces),
        separator: element.dataset.separator,
        decimal: element.dataset.decimal,
        suffix: element.dataset.suffix,
      }).start();
    });
  });

  document.querySelectorAll<HTMLElement>("[data-count-up]").forEach((element) => observer.observe(element));
</script>
