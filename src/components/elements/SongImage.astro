---
import PlaceholderSongImage from "@assets/images/placeholder_song.jpg";
import { Image } from "astro:assets";

interface Props {
  track: string;
  coverUrl: string | null;
}

const { track, coverUrl } = Astro.props;
const altText = `Cover for ${track}`;
---

{coverUrl ? (
  <img
    src={coverUrl}
    alt={altText}
    width={64}
    height={64}
    loading="lazy"
    decoding="async"
    class="min-h-64px min-w-64px rounded-sm"
  />
) : (
  <Image src={PlaceholderSongImage} alt={altText} width={64} height={64} class="min-h-64px min-w-64px rounded-sm" />
)}
