---
import "gridjs/dist/theme/mermaid.css";

import { useTranslations } from "@i18n/index";

interface Props {
  data: (string | number | boolean | Date)[][];
}

const { data } = Astro.props;

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const i18nData = JSON.stringify({
  distance: t("swimming.distance"),
  stroke: t("swimming.stroke"),
  time: t("swimming.time"),
  date: t("swimming.date"),
  city: t("swimming.city"),
  country: t("swimming.country"),
  poolLength: t("swimming.poolLength"),
  partialDistance: t("swimming.partialDistance"),
  yes: t("swimming.yes"),
});
---

<div>
  <div class="flex flex-col">
    <label>
      <input type="checkbox" id="bestTimesToggle" checked />
      <span>{t("swimming.onlyBestTimes")}</span>
    </label>
    <label>
      <input type="checkbox" id="showPartialsToggle" checked />
      <span>{t("swimming.showPartials")}</span>
    </label>
  </div>

  <div class="overflow-x-auto">
    <div
      id="wrapper"
      class="text-xs sm:text-sm md:text-base"
      data-i18n={i18nData}
      data-rows={JSON.stringify(data)}
    ></div>
  </div>
</div>

<script>
  import { Grid } from "gridjs";

  type Row = [number, string, number, string, string, string, number, number];

  function initTable() {
    const wrapper = document.getElementById("wrapper");
    const bestTimesToggle = document.getElementById("bestTimesToggle") as HTMLInputElement | null;
    const showPartialsToggle = document.getElementById("showPartialsToggle") as HTMLInputElement | null;
    if (!wrapper || !bestTimesToggle || !showPartialsToggle) return;

    const i18n: Record<string, string> = JSON.parse(wrapper.dataset.i18n || "{}");
    const data: string[][] = JSON.parse(wrapper.dataset.rows || "[]");
    let gridInstance: Grid | null = null;

    // Remove tabindex from th elements to fix accessibility audit warning
    // Grid.js adds tabindex for sortable headers, but th elements should not have tabindex
    // Use MutationObserver to catch any additions
    const observer = new MutationObserver(() => {
      wrapper.querySelectorAll("th[tabindex]").forEach((th) => {
        th.removeAttribute("tabindex");
      });
    });
    observer.observe(wrapper, { childList: true, subtree: true, attributes: true, attributeFilter: ["tabindex"] });

    function formatTime(seconds: number) {
      const minutes = Math.floor(seconds / 60);
      const remainingSeconds = seconds % 60;

      if (minutes > 0) {
        return `${minutes}:${remainingSeconds.toFixed(2).padStart(5, "0")}`;
      }

      return remainingSeconds.toFixed(2);
    }

    // Convert to data types
    const processedData: Row[] = data.map((row) => [
      parseFloat(row[0]), // Distance
      row[1], // Stroke
      parseFloat(row[2]), // Time (keep as number for sorting)
      row[3], // Date
      row[4], // City
      row[5], // Country
      parseInt(row[6]), // Pool Length
      parseInt(row[7]), // IsPartialDistance (0 or 1)
    ]);

    function filterPartials(rows: Row[], showPartials: boolean) {
      if (showPartials) return rows;
      return rows.filter((row) => row[7] === 0);
    }

    function getBestTimes(rows: Row[]) {
      const bestTimes: Record<string, Row> = {};

      rows.forEach((row) => {
        const key = `${row[0]}-${row[1]}`;
        if (!bestTimes[key] || row[2] < bestTimes[key][2]) {
          bestTimes[key] = row;
        }
      });

      return Object.values(bestTimes);
    }

    function createGrid(showBestOnly: boolean, showPartials: boolean) {
      let dataToShow = filterPartials(processedData, showPartials);
      if (showBestOnly) {
        dataToShow = getBestTimes(dataToShow);
      }

      const columns = [
        {
          name: i18n.distance || "Distance",
          formatter: (cell: unknown) => `${cell}m`,
        },
        i18n.stroke || "Stroke",
        {
          name: i18n.time || "Time",
          formatter: (cell: unknown) => formatTime(Number(cell)),
        },
        i18n.date || "Date",
        i18n.city || "City",
        i18n.country || "Country",
        {
          name: i18n.poolLength || "Pool Length",
          formatter: (cell: unknown) => `${cell}m`,
        },
      ];

      // Only add Partial Distance column if showing partials
      if (showPartials) {
        columns.push({
          name: i18n.partialDistance || "Partial Distance?",
          formatter: (cell: unknown) => (cell === 1 ? i18n.yes || "Yes" : ""),
        });
      }
      // Adjust data to match columns
      const adjustedData = showPartials ? dataToShow : dataToShow.map((row) => row.slice(0, 7)); // Remove last column (Partial Distance)

      gridInstance?.destroy();

      gridInstance = new Grid({
        columns: columns,
        data: adjustedData,
        sort: true,
        pagination: { limit: 20 },
        search: true,
      });

      gridInstance.render(wrapper!);
    }

    // Initial render
    createGrid(bestTimesToggle.checked, showPartialsToggle.checked);

    function updateGrid() {
      createGrid(bestTimesToggle!.checked, showPartialsToggle!.checked);
    }
    bestTimesToggle.addEventListener("change", updateGrid);
    showPartialsToggle.addEventListener("change", updateGrid);
  }

  initTable();
</script>
