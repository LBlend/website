---
import { Image } from "astro:assets";

import { useTranslations } from "@i18n/index";

import { HEIGHT, SPHERE, WIDTH, getMap } from "./visitedPlaces";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const { countries, dots, visitedNames } = getMap(locale);

const DOT_RADIUS = 3;
---

<section id="visited-places" class="flex flex-col gap-4">
  <h2 class="text-4xl font-bold">{t("visitedPlaces.title")}</h2>
  <p>{t("visitedPlaces.description")}</p>
  <div class="visited-map relative w-full overflow-hidden select-none" data-visited-map data-dot-radius={DOT_RADIUS}>
    <svg
      data-map
      viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
      class="block h-auto w-full cursor-grab active:cursor-grabbing"
      role="img"
      aria-label={t("visitedPlaces.mapLabel")}
    >
      <g data-zoom-layer>
        <path d={SPHERE} class="water" />
        {countries.map((country) => (
          <path d={country.d} class={country.status} data-name={country.name} />
        ))}
        {dots.map((dot) => (
          <circle cx={dot.cx} cy={dot.cy} r={DOT_RADIUS} class={dot.status} data-name={dot.name} />
        ))}
      </g>
    </svg>
    <div
      class="pointer-events-none absolute top-0 left-0 hidden rounded-md bg-gray-900/90 px-2 py-1 text-sm whitespace-nowrap text-gray-100 shadow-lg"
      data-tooltip
    ></div>
    <div
      class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/50 text-lg font-semibold text-gray-100 opacity-0 transition-opacity duration-300"
      data-zoom-hint
    >
      {t("visitedPlaces.zoomHint")}
    </div>
    <div class="absolute right-2 bottom-2 flex flex-col overflow-hidden rounded-lg bg-gray-800/80 text-lg leading-none shadow-lg">
      <button
        type="button"
        class="size-8 cursor-pointer hover:bg-gray-700"
        aria-label={t("visitedPlaces.zoomIn")}
        data-zoom="in"
      >
        +
      </button>
      <button
        type="button"
        class="size-8 cursor-pointer hover:bg-gray-700"
        aria-label={t("visitedPlaces.zoomOut")}
        data-zoom="out"
      >
        −
      </button>
      <button
        type="button"
        class="size-8 cursor-pointer text-base hover:bg-gray-700"
        aria-label={t("visitedPlaces.resetZoom")}
        data-zoom="reset"
      >
        <svg
          viewBox="0 0 24 24"
          class="mx-auto size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
          <path d="M3 3v5h5" />
        </svg>
      </button>
    </div>
  </div>
  <ul class="sr-only" aria-label={t("visitedPlaces.visitedList")}>
    {visitedNames.map((name) => (
      <li>{name}</li>
    ))}
  </ul>
  <a href="https://my.flightradar24.com/LBlend" class="mx-auto w-fit lg:mx-0">
    <Image
      src="https://banners-my.flightradar24.com/LBlend.png"
      alt="My Flightdiary.net profile"
      width="320"
      height="70"
    />
  </a>
</section>

<style>
  .visited-map [data-zoom-layer] > * {
    stroke: var(--background);
    stroke-width: 0.5px;
    vector-effect: non-scaling-stroke;
    transition: fill 150ms;
  }

  .visited-map [data-zoom-layer] .water {
    fill: #1a1d30;
    stroke: none;
  }

  .visited-map [data-zoom-layer] .unvisited {
    fill: var(--color-gray-700);
  }

  .visited-map [data-zoom-layer] .visited {
    fill: var(--accent);
  }

  .visited-map [data-zoom-layer] .home {
    fill: #2555bb;
  }

  .visited-map [data-zoom-layer] .unvisited:hover {
    fill: var(--color-gray-500);
  }

  .visited-map [data-zoom-layer] .visited:hover {
    fill: var(--accent-light);
  }

  .visited-map [data-zoom-layer] .home:hover {
    fill: #4a78d6;
  }
</style>

<script>
  import { select } from "d3-selection";
  import "d3-transition";
  import { zoom, zoomIdentity } from "d3-zoom";

  const MAX_ZOOM = 12;
  const BUTTON_STEP = 2;
  const MAX_WHEEL_STEP = 0.5; // log2 of the scale factor, so at most ~1.4x per event

  document.querySelectorAll<HTMLElement>("[data-visited-map]").forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>("[data-map]")!;
    const layer = root.querySelector<SVGGElement>("[data-zoom-layer]")!;
    const tooltip = root.querySelector<HTMLElement>("[data-tooltip]")!;
    const hint = root.querySelector<HTMLElement>("[data-zoom-hint]")!;
    const dots = layer.querySelectorAll<SVGCircleElement>("circle");
    const dotRadius = Number(root.dataset.dotRadius);
    const { width, height } = svg.viewBox.baseVal;

    // Zoom

    let hintTimeout: ReturnType<typeof setTimeout> | undefined;
    const showHint = () => {
      hint.classList.replace("opacity-0", "opacity-100");
      clearTimeout(hintTimeout);
      hintTimeout = setTimeout(() => hint.classList.replace("opacity-100", "opacity-0"), 1200);
    };

    const behavior = zoom<SVGSVGElement, unknown>()
      .scaleExtent([1, MAX_ZOOM])
      // d3's default, but capped so a Ctrl + mouse wheel notch doesn't zoom several levels at once.
      // Trackpad pinches send many small deltas and are unaffected
      .wheelDelta((event: WheelEvent) => {
        const delta =
          -event.deltaY * (event.deltaMode === 1 ? 0.05 : event.deltaMode ? 1 : 0.002) * (event.ctrlKey ? 10 : 1);
        return Math.max(-MAX_WHEEL_STEP, Math.min(MAX_WHEEL_STEP, delta));
      })
      .translateExtent([
        [0, 0],
        [width, height],
      ])
      .filter((event: MouseEvent | WheelEvent | TouchEvent) => {
        // Plain scrolling scrolls the page. Ctrl + scroll (and trackpad pinch, which sets ctrlKey) zooms
        if (event.type === "wheel") {
          if (event.ctrlKey || event.metaKey) return true;
          showHint();
          return false;
        }
        return !event.ctrlKey && !(event as MouseEvent).button;
      })
      .on("zoom", ({ transform }) => {
        layer.setAttribute("transform", transform.toString());
        // Keep dots the same size on screen
        dots.forEach((dot) => dot.setAttribute("r", String(dotRadius / transform.k)));
        hideTooltip();
      });

    const selection = select(svg).call(behavior);

    root.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((button) => {
      button.addEventListener("click", () => {
        const transition = selection.transition().duration(300);
        if (button.dataset.zoom === "in") transition.call(behavior.scaleBy, BUTTON_STEP);
        else if (button.dataset.zoom === "out") transition.call(behavior.scaleBy, 1 / BUTTON_STEP);
        else transition.call(behavior.transform, zoomIdentity);
      });
    });

    // Tooltip

    function hideTooltip() {
      tooltip.classList.add("hidden");
    }

    function showTooltip(event: PointerEvent) {
      const name = (event.target as Element).closest("[data-name]")?.getAttribute("data-name");
      if (!name) return hideTooltip();

      tooltip.textContent = name;
      tooltip.classList.remove("hidden");

      const bounds = root.getBoundingClientRect();
      const offset = 12;
      let x = event.clientX - bounds.left + offset;
      let y = event.clientY - bounds.top + offset;
      if (x + tooltip.offsetWidth > bounds.width) x -= tooltip.offsetWidth + 2 * offset;
      if (y + tooltip.offsetHeight > bounds.height) y -= tooltip.offsetHeight + 2 * offset;
      tooltip.style.transform = `translate(${x}px, ${y}px)`;
    }

    svg.addEventListener("pointermove", (event) => {
      // Don't show labels while dragging the map
      if (event.buttons === 0) showTooltip(event);
    });
    // Touch has no hover, so tapping a country shows its label
    svg.addEventListener("pointerup", (event) => {
      if (event.pointerType !== "mouse") showTooltip(event);
    });
    svg.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") hideTooltip();
    });
    document.addEventListener("pointerdown", (event) => {
      if (!root.contains(event.target as Node)) hideTooltip();
    });
  });
</script>
