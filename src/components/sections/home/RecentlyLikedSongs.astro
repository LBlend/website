---
import { formatDistance } from "date-fns";
import { ko, nb } from "date-fns/locale";

import Song from "@elements/Song.astro";
import { useTranslations } from "@i18n/index";
import { getRecentlyLikedSongs, type LikedSong } from "@lib/music/recent";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const dateFnsLocales = { en: undefined, no: nb, ko: ko };
const dateFnsLocale = dateFnsLocales[locale];

const songs = await getRecentlyLikedSongs(1000);

const groupedTracks = songs.reduce((acc: Record<string, LikedSong[]>, song) => {
  const distance = formatDistance(song.likedAt, new Date(), { addSuffix: true, locale: dateFnsLocale });
  (acc[distance] ??= []).push(song);
  return acc;
}, {});
---

<div class="flex w-full flex-col gap-8 p-6">
  <h3 class="text-center text-4xl font-bold lg:text-left lg:text-2xl">{t("recentlyLikedSongs.title")}</h3>
  <div class="flex flex-col gap-8">
    {songs.length === 0 && <p class="text-center text-gray-500">{t("recentlyLikedSongs.fetchError")}</p>}
    {Object.entries(groupedTracks).map(([time, tracks]) => (
      <div class="flex flex-col gap-4">
        <h2 class="border-b border-gray-700 text-center font-semibold">{time}</h2>
        <div class="flex flex-col gap-6">
          {tracks.map((song) => (
            <Song song={song} />
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
