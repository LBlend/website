---
import BabyIcon from "@assets/icons/logos/baby.svg";
import HouseIcon from "@assets/icons/logos/house.svg";
import SchoolIcon from "@assets/icons/logos/school_generic.svg";
import { useTranslations } from "@i18n/index";
import { Image } from "astro:assets";
import {
  type TimelineCategory,
  type TimelineEvent,
  type TimelineRole,
  assignLanes,
  createTimeScale,
  endOf,
  formatDuration,
  getCoveredTime,
  getTimelineEvents,
} from "./timeline";

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const now = new Date();
const formatDays = (days: number) => t(days === 1 ? "about.durationDay" : "about.durationDays", { count: days });

const images = import.meta.glob<{ default: ImageMetadata }>([
  "/src/assets/icons/logos/**/*.{jpeg,jpg,png,gif,svg,ico,webp}",
  "!/src/assets/icons/logos/baby.svg",
  "!/src/assets/icons/logos/house.svg",
  "!/src/assets/icons/logos/school_generic.svg",
]);

const events = getTimelineEvents();
const scale = createTimeScale(events, now);

function formatDate(date: Date) {
  return date.toLocaleDateString(locale, { month: "short", year: "numeric" });
}

function formatRange(item: TimelineEvent | TimelineRole) {
  if ("isPointInTime" in item && item.isPointInTime) return formatDate(item.start);
  if (item.end === null) return `${formatDate(item.start)} – ${t("about.present")}`;
  const start = formatDate(item.start);
  const end = formatDate(item.end);
  return start === end ? start : `${start} – ${end}`;
}

const categoryMeta: Record<TimelineCategory, { label: string; color: string; icon: string }> = {
  life: { label: t("about.categoryLife"), color: "#e879f9", icon: "★" },
  education: { label: t("about.categoryEducation"), color: "#38bdf8", icon: "🎓" },
  work: { label: t("about.categoryWork"), color: "#4ade80", icon: "💼" },
  volunteer: { label: t("about.categoryVolunteer"), color: "#fb923c", icon: "🤝" },
  certification: { label: t("about.categoryCertification"), color: "#facc15", icon: "📜" },
};

const MS_PER_MONTH = 1000 * 60 * 60 * 24 * 30.44;
const PX_PER_MONTH = 4;
const SEGMENT_HEIGHT = 8;
const SEGMENT_GAP = 3;

const margins: number[] = events.map((event, i) => {
  if (i === 0) return 0;
  const monthsGap = (endOf(events[i - 1], now).getTime() - endOf(event, now).getTime()) / MS_PER_MONTH;
  return Math.max(0, Math.round(monthsGap * PX_PER_MONTH));
});
---

<section id="timeline" class="grid gap-6">
  <h2 class="mb-2 text-2xl font-bold tracking-tight text-white">{t("about.timeline")}</h2>

  <div class="mb-10 flex flex-wrap justify-center gap-x-2 gap-y-2">
    {Object.entries(categoryMeta).map(([key, meta]) => (
      <button
        class="tl-filter-btn flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-700 px-3 py-1 text-xs tracking-wider text-slate-400 uppercase transition-all duration-200 hover:border-slate-500 hover:text-slate-200"
        data-filter={key}
        style={`--btn-accent:${meta.color}`}
      >
        <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-(--btn-accent)" />
        {meta.label}
      </button>
    ))}
  </div>

  <div class="tl-root relative">
    {events.map((event, i) => {
      const meta = categoryMeta[event.category];
      const segments = event.roles ?? [event];
      const { lanes, count: laneCount } = assignLanes(segments, now);
      const trackHeight = laneCount * SEGMENT_HEIGHT + (laneCount - 1) * SEGMENT_GAP;
      return (
        <div
          class={`tl-item relative ${i % 2 === 0 ? "is-left" : "is-right"}`}
          style={`--accent:${meta.color}; margin-top:${margins[i]}px;`}
          data-category={event.category}
          data-date={endOf(event, now).getTime()}
        >
          <div class="tl-dot-col">
            <span class="tl-dot block h-3.5 w-3.5 rounded-full transition-transform duration-200" />
          </div>

          <div class="tl-card-col fade-in-section">
            <div class="tl-card relative rounded-lg border border-slate-800 px-4 py-3">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-1">
                  <div class="tl-meta mb-1.5 flex flex-wrap items-center gap-2">
                    <span class="tl-badge rounded-full px-2.5 py-0.5 text-xs font-semibold tracking-widest whitespace-nowrap text-(--accent) uppercase">
                      {meta.icon} {meta.label}
                    </span>
                    <time class="text-xs tracking-wide text-slate-500">{formatRange(event)}</time>
                  </div>
                  <h3 class="tl-title mb-0.5 text-base leading-snug font-bold text-slate-100">
                    {event.url ? (
                      <a href={event.url} target="_blank" rel="noopener noreferrer" class="non-styled-link">
                        {event.title}
                        <span class="tl-external text-xs font-normal" aria-hidden="true">
                          ↗
                        </span>
                      </a>
                    ) : (
                      event.title
                    )}
                  </h3>
                  {event.subtitle && <p class="tl-subtitle text-sm text-slate-400">{event.subtitle}</p>}
                </div>

                <div class="flex shrink-0 self-center">
                  {event.image?.endsWith("school_generic.svg") ? (
                    <SchoolIcon class="size-8 text-white" />
                  ) : event.image?.endsWith("baby.svg") ? (
                    <BabyIcon class="size-8 text-white" />
                  ) : event.image?.endsWith("house.svg") ? (
                    <HouseIcon class="size-8 text-white" />
                  ) : event.image && images[event.image] ? (
                    <Image
                      src={images[event.image]()}
                      alt={event.title}
                      width={48}
                      height={48}
                      class="size-12 rounded-lg bg-slate-800 p-1"
                    />
                  ) : (
                    <SchoolIcon class="size-8 text-white" />
                  )}
                </div>
              </div>

              <div class="mt-3">
                <div
                  class:list={["tl-track relative", laneCount > 1 ? "rounded-md" : "rounded-full"]}
                  style={`height:${trackHeight}px`}
                >
                  <span
                    class:list={[
                      "tl-track-compressed absolute top-0 left-0 h-full",
                      laneCount > 1 ? "rounded-l-md" : "rounded-l-full",
                    ]}
                    style={`width:${scale.compressedPercent}%`}
                  />
                  {scale.ticks.map(({ percent }) => (
                    <span class="tl-tick absolute top-0 h-full w-px" style={`left:${percent}%`} />
                  ))}
                  {event.isPointInTime ? (
                    <span
                      class="absolute top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-(--accent)"
                      style={`left:${scale.toPercent(event.start)}%`}
                    />
                  ) : (
                    segments.map((segment) => (
                      <span
                        class="tl-segment absolute rounded-full bg-(--accent) opacity-85"
                        data-role-id={event.roles ? segment.id : undefined}
                        style={`top:${lanes.get(segment.id)! * (SEGMENT_HEIGHT + SEGMENT_GAP)}px; height:${SEGMENT_HEIGHT}px; left:${scale.toPercent(segment.start)}%; width:max(4px, ${scale.toPercent(endOf(segment, now)) - scale.toPercent(segment.start)}%)`}
                      />
                    ))
                  )}
                </div>
                <div class="relative mt-1 h-3 text-[10px] text-slate-600">
                  {scale.ticks
                    .filter(({ label }) => label)
                    .map(({ year, percent, compressed }) => (
                      <span
                        class:list={["absolute -translate-x-1/2", compressed && "hidden sm:inline"]}
                        style={`left:${percent}%`}
                      >
                        {year}
                      </span>
                    ))}
                </div>
                {!event.isPointInTime && (
                  <p class="tl-duration mt-2 mb-2 text-xs text-slate-400">
                    {formatDuration(getCoveredTime(segments, now), locale, formatDays)}
                  </p>
                )}
              </div>

              {event.roles ? (
                <ul class="mt-3 flex flex-col gap-1 border-t border-slate-800 pt-2">
                  {event.roles.map((role) => (
                    <li class="tl-role" data-role-id={role.id}>
                      <div class="flex flex-wrap items-baseline gap-x-2">
                        <span class="text-sm font-semibold text-slate-200">{role.title}</span>
                        <time class="text-xs text-slate-500">{formatRange(role)}</time>
                        <span class="text-xs text-slate-600">
                          · {formatDuration(getCoveredTime([role], now), locale, formatDays)}
                        </span>
                      </div>
                      {role.description && (
                        <p class="text-xs leading-relaxed whitespace-pre-line text-slate-500">{role.description}</p>
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                event.description && (
                  <p class="mt-1.5 text-sm leading-relaxed whitespace-pre-line text-slate-500">{event.description}</p>
                )
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .tl-item {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: start;
    padding-bottom: 2rem;
  }
  @media (min-width: 640px) {
    .tl-item {
      grid-template-columns: 1fr 2rem 1fr;
    }
  }

  .tl-dot-col {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.75rem;
    position: relative;
    z-index: 10;
  }
  @media (min-width: 640px) {
    .tl-dot-col {
      grid-column: 2;
    }
  }

  .tl-card-col {
    grid-column: 2;
    grid-row: 1;
    padding-left: 1rem;
  }
  @media (min-width: 640px) {
    .tl-item.is-left .tl-card-col {
      grid-column: 1;
      padding-left: 0;
      padding-right: 1rem;
    }
    .tl-item.is-right .tl-card-col {
      grid-column: 3;
      padding-left: 1rem;
      padding-right: 0;
    }
    .tl-item.is-left .tl-card {
      border-left-width: 1px !important;
      border-right-width: 3px !important;
      border-right-color: var(--accent) !important;
      border-left-color: var(--backgroundlight) !important;
    }
    .tl-item.is-left .tl-meta {
      flex-direction: row-reverse;
    }
    .tl-item.is-left .tl-title,
    .tl-item.is-left .tl-subtitle,
    .tl-item.is-left .tl-duration {
      text-align: right;
    }
    .tl-item.is-right .tl-card {
      border-left-width: 3px !important;
      border-left-color: var(--accent) !important;
      border-right-width: 1px !important;
    }
  }

  .tl-root::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1rem;
    transform: translateX(-50%);
    width: 2px;
    background: linear-gradient(to bottom, transparent, #334155 4%, #334155 96%, transparent);
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .tl-root::before {
      left: 50%;
    }
  }

  .tl-dot {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    flex-shrink: 0;
  }
  .tl-item:hover .tl-dot {
    transform: scale(1.45);
    box-shadow: 0 0 22px var(--accent);
  }

  .tl-card {
    background: var(--backgroundlight);
    border-left-width: 3px;
    border-left-color: var(--accent);
    cursor: default;
  }
  .tl-card a {
    cursor: pointer;
  }

  .tl-badge {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .tl-external {
    margin-left: 0.2em;
    -webkit-text-fill-color: var(--color-slate-500);
  }

  .tl-track {
    background: rgb(148 163 184 / 0.14);
  }
  .tl-track-compressed {
    background: rgb(0 0 0 / 0.3);
  }
  .tl-tick {
    background: rgb(148 163 184 / 0.25);
  }

  .tl-segment {
    transition:
      opacity 0.15s,
      box-shadow 0.15s;
  }
  .tl-segment[data-role-id] {
    cursor: pointer;
  }
  .tl-segment[data-role-id]::before {
    content: "";
    position: absolute;
    inset: -3px 0;
  }
  .tl-card.has-highlight .tl-segment:not(.is-highlighted) {
    opacity: 0.25;
  }
  .tl-segment.is-highlighted {
    opacity: 1;
    box-shadow: 0 0 8px var(--accent);
  }

  .tl-role {
    margin-inline: -0.375rem;
    padding: 0.25rem 0.375rem;
    border-radius: 0.375rem;
    transition:
      background 0.15s,
      opacity 0.15s;
  }
  .tl-card.has-highlight .tl-role:not(.is-highlighted) {
    opacity: 0.45;
  }
  .tl-role.is-highlighted {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .tl-filter-btn.is-active {
    background: color-mix(in srgb, var(--btn-accent) 15%, transparent);
    border-color: var(--btn-accent);
    color: var(--btn-accent);
  }

  .tl-item.is-hidden {
    display: none;
  }
</style>

<script>
  const MS_PER_MONTH = 1000 * 60 * 60 * 24 * 30.44;
  const PX_PER_MONTH = 4;

  const buttons = document.querySelectorAll(".tl-filter-btn");
  const items = Array.from(document.querySelectorAll(".tl-item"));
  const active = new Set<string>();

  function recalcMargins(visibleItems: Element[]) {
    visibleItems.forEach((item, idx) => {
      const el = item as HTMLElement;
      if (idx === 0) {
        el.style.marginTop = "0px";
        return;
      }
      const prev = visibleItems[idx - 1] as HTMLElement;
      const months = (parseInt(prev.dataset.date!) - parseInt(el.dataset.date!)) / MS_PER_MONTH;
      el.style.marginTop = Math.max(0, Math.round(months * PX_PER_MONTH)) + "px";
    });
  }

  function applyFilter() {
    items.forEach((item) => {
      const el = item as HTMLElement;
      const visible = active.size === 0 || active.has(el.dataset.category!);
      el.classList.toggle("is-hidden", !visible);
    });
    const visible = items.filter((el) => !el.classList.contains("is-hidden"));
    visible.forEach((item, idx) => {
      item.classList.toggle("is-left", idx % 2 === 0);
      item.classList.toggle("is-right", idx % 2 !== 0);
    });
    recalcMargins(visible);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = (btn as HTMLElement).dataset.filter ?? "";
      if (active.has(key)) {
        active.clear();
        btn.classList.remove("is-active");
      } else {
        active.clear();
        buttons.forEach((b) => b.classList.remove("is-active"));
        active.add(key);
        btn.classList.add("is-active");
      }
      applyFilter();
    });
  });

  document.querySelectorAll<HTMLElement>(".tl-card").forEach((card) => {
    const linked = card.querySelectorAll<HTMLElement>("[data-role-id]");

    linked.forEach((element) => {
      element.addEventListener("mouseenter", () => {
        card.classList.add("has-highlight");
        linked.forEach((other) =>
          other.classList.toggle("is-highlighted", other.dataset.roleId === element.dataset.roleId),
        );
      });
      element.addEventListener("mouseleave", () => {
        card.classList.remove("has-highlight");
        linked.forEach((other) => other.classList.remove("is-highlighted"));
      });
    });
  });
</script>
